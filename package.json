{
  "name": "gtm-swim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-warnings next dev",
    "build": "next build",
    "start": "cross-env NODE_OPTIONS=--no-warnings next start --hostname 127.0.0.1 --port 3111",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "bot": "node --no-warnings --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/feishu-bot.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.75.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "2.57.4",
    "exceljs": "^4.4.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^8.12.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
