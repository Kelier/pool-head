TIKHUB_API_KEY=
TIKHUB_GLOBAL_QPS=3
TIKHUB_PLATFORM_CONCURRENCY=2
TIKHUB_DAILY_BUDGET_CALLS=5000
TIKHUB_TIMEOUT_MS=45000
TIKHUB_MAX_RETRIES=3

# 本机直连 TikHub 不通（DNS/VPN）时使用，如 http://127.0.0.1:7890；留空=直连
TIKHUB_PROXY=

# ── 飞书机器人（可选，详见 docs/FEISHU_BOT.md）──
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 网页登录：public 免登录查看，feishu 使用飞书，hoe 使用 HOE，hoe_approval 额外要求飞书审批。
WEB_AUTH_MODE=public
HOE_SUPABASE_URL=
HOE_SUPABASE_ANON_KEY=
# HOE 登录 API 提供腾讯人机验证配置并校验登录。
HOE_HOGI_API_URL=https://api-hoe-qc.hogi.ai
# 飞书登录模式使用服务端 Secret key。
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# 可选：仅允许此飞书租户登录。留空时由飞书应用可用范围控制。
FEISHU_WEB_TENANT_KEY=
# 允许通过已验证 HOE 邮箱自动查找飞书身份的账号，逗号分隔。需要通讯录权限。
HOE_APPROVAL_AUTO_BIND_EMAILS=
# 长连接机器人与 Web 进程设置相同的随机密钥（至少 32 字符）。
BOT_BACKEND_SECRET=
# webhook 模式才需要：事件订阅页的 Verification Token / Encrypt Key
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# 授权（默认拒绝）：管理员可发起抓取；成员只读+导出。逗号分隔的 open_id / chat_id
FEISHU_ADMIN_OPEN_IDS=
FEISHU_ALLOWED_USERS=
FEISHU_ALLOWED_CHATS=
# 国际版 Lark 填 https://open.larksuite.com；默认飞书
FEISHU_BASE_URL=
FEISHU_MODE=longconn
FEISHU_PUSH_ALERTS=1
# 长连接机器人访问 Web 应用的地址 / 卡片里"查看详情"链接的公开地址
APP_BASE_URL=http://127.0.0.1:3111
APP_PUBLIC_URL=http://localhost:3111

# ── 飞书机器人 · 意图层（自然语言）──
# off=关闭；rules=仅规则（默认，免费、离线）；
# llm=规则不确定、需要多轮上下文或分析时使用大模型；所有消息统一经过意图层，抓取先确认。
BOT_AGENT=rules
# 大模型提供方：deepseek（默认）| anthropic | openai（任意 OpenAI 兼容服务）
BOT_LLM_PROVIDER=deepseek
# DeepSeek（BOT_AGENT=llm 时必填）。默认模型 deepseek-flash；思考模式见下方 BOT_LLM_THINKING
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
# 覆盖默认模型（如 deepseek-v4-pro；anthropic 默认 claude-haiku-5-5）
BOT_LLM_MODEL=
# 改用 Claude：BOT_LLM_PROVIDER=anthropic + ANTHROPIC_API_KEY（可选 ANTHROPIC_BASE_URL）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# 改用其他 OpenAI 兼容服务：BOT_LLM_PROVIDER=openai，三项都要填（base 含 /v1，如 https://xxx/v1）
BOT_LLM_API_KEY=
BOT_LLM_BASE_URL=
# ── 思考模式（目前仅 deepseek 生效）──
# off=都不思考（默认，最快最省）；analysis=只在"解读"阶段思考（推荐）；all=规划也思考
BOT_LLM_THINKING=off
# 思考强度 low|high|max（默认 high）
BOT_LLM_REASONING_EFFORT=high
# 解读阶段单独用更强的模型（如 deepseek-v4-pro），规划仍用上面的便宜模型；留空=同一个模型
BOT_LLM_ANALYSIS_MODEL=
# ── 成本闸门（按天统计，落库，重启不丢；规划与解读各算一次调用）──
BOT_LLM_DAILY_CAP=200
BOT_LLM_USER_DAILY_CAP=40
# 全员每日 token 上限（输入+输出），0=不限
BOT_LLM_DAILY_TOKENS=1000000
BOT_LLM_TIMEOUT_MS=15000
# 开启思考时的超时（思考更慢）
BOT_LLM_THINK_TIMEOUT_MS=60000
# 周报：每周几@几点推给已订阅会话，如 mon@9 / fri@17；off 或留空=不推（也可在飞书里对管理员说"开启周报每周五17点"）
BOT_DIGEST=

# 视频号是否补粉丝数（每个命中账号多 1 次调用；接口对不少账号返回 0，会显示"未知"）。on（默认）| off
WECHAT_CHANNELS_FANS=on

# 本机飞书长连接的 PR 审批。审批用户还需通过上方飞书机器人访问权限。
FEISHU_NPR_EXECUTABLE=
FEISHU_NPR_OPEN_IDS=
FEISHU_NPR_REPOS=
